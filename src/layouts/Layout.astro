---
import '../styles/global.css';
import { TITLE, SUBTITLE, DESCRIPTION, withBase } from '../lib/site';
interface Props {
  title?: string;
  description?: string;
  article?: boolean;
  date?: Date;
  tags?: string[];
  noindex?: boolean;
}
const { title, description = DESCRIPTION, article = false, date, tags = [], noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${TITLE}` : `${TITLE} — ${SUBTITLE}`;
const canonical = new URL(Astro.url.pathname.endsWith('/404/') ? withBase('404.html') : Astro.url.pathname, Astro.site);
const socialImage = new URL(withBase('social.png'), Astro.site);
const isHome = Astro.url.pathname.replace(/\/$/, '') === withBase().replace(/\/$/, '');
const isAbout = Astro.url.pathname.replace(/\/$/, '').endsWith('/about');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f6f0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={TITLE} href={withBase('rss.xml')} />
    <link rel="sitemap" href={withBase('sitemap-index.xml')} />
    <meta property="og:site_name" content={TITLE} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title || TITLE} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={`${TITLE}. ${SUBTITLE}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title || TITLE} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {date && <meta property="article:published_time" content={date.toISOString()} />}
    {tags.map(tag => <meta property="article:tag" content={tag} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="shell">
      <header class="site-header">
        <a class="wordmark" href={withBase()} aria-label="Loose Threads home">Loose Threads<span aria-hidden="true"> /</span></a>
        <nav aria-label="Main navigation">
          <a href={withBase()} aria-current={isHome ? 'page' : undefined}>Writing</a>
          <a href={withBase('about/')} aria-current={isAbout ? 'page' : undefined}>About</a>
        </nav>
      </header>
      <main id="main" tabindex="-1"><slot /></main>
      <footer class="site-footer">
        <span>{SUBTITLE}</span>
        <a href={withBase('rss.xml')}>RSS <span aria-hidden="true">↗</span></a>
      </footer>
    </div>
  </body>
</html>
